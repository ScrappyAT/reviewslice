# Postgres connection string for the local dev database. Started with
# `docker compose up -d` (see docker-compose.yml, service `db`) — the
# user/password/db name here match the POSTGRES_USER / POSTGRES_PASSWORD /
# POSTGRES_DB set there, and 5436 is the host port that compose file maps
# to the container's 5432. Not a secret: these are local-only dev
# credentials already committed in plain text in docker-compose.yml.
DATABASE_URL="postgresql://reviewslice:localdevpassword@localhost:5436/reviewslice?schema=public"

# DeepSeek API key, from https://platform.deepseek.com (account settings ->
# API keys). Written in by hand after `cp .env.example .env` — never by an
# agent, and never committed. Leave blank here.
DEEPSEEK_API_KEY=
